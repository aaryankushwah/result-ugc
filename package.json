{
  "name": "result-ugc",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:packages": "pnpm --filter @result/domain build && pnpm --filter @result/db build",
    "build:apps": "pnpm --filter @result/web exec next build && pnpm --filter @result/discord-bot build",
    "build": "pnpm build:packages && pnpm build:apps",
    "check:apps": "pnpm --filter @result/web lint && pnpm --filter @result/discord-bot check",
    "check": "pnpm build:packages && pnpm check:apps",
    "db:generate": "pnpm --filter @result/db generate",
    "db:migrate": "pnpm --filter @result/db migrate",
    "dev:web": "pnpm --filter @result/web dev",
    "dev:bot": "pnpm --filter @result/discord-bot dev",
    "test:apps": "pnpm --filter @result/web test && pnpm --filter @result/discord-bot test",
    "test": "pnpm build:packages && pnpm test:apps",
    "verify": "pnpm build:packages && pnpm check:apps && pnpm test:apps && pnpm build:apps"
  }
}
