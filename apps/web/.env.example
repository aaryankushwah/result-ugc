# Neon pooled connection used by the portal and Discord bot.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Viral.app API. Keep the value server-only.
VIRAL_APP_API_KEY=replace_with_your_viral_api_key

# Launchpoint read-only Developer API key. Used to synchronize the complete
# creator directory, signing relationships, and discover social identities.
LAUNCHPOINT_API_KEY=replace_with_your_launchpoint_api_key

# Discord OAuth application and Result guild.
DISCORD_CLIENT_ID=replace_with_your_application_id
DISCORD_CLIENT_SECRET=replace_with_your_application_secret
DISCORD_GUILD_ID=replace_with_your_result_guild_id

# Comma-separated Discord role IDs. Admin and manager roles can mutate data;
# authorized roles are read-only viewers.
DISCORD_ADMIN_ROLE_IDS=role_id_1,role_id_2
DISCORD_MANAGER_ROLE_IDS=role_id_3
DISCORD_AUTHORIZED_ROLE_IDS=role_id_4

# Generate long independent random values for sessions and the Viral cron.
SESSION_SECRET=replace_with_at_least_32_random_characters
CRON_SECRET=replace_with_a_different_random_secret

# Script Studio AI. Both the rewrite (anthropic/claude-sonnet-5) and the
# transcription (openai/whisper-1) route through the Vercel AI Gateway, so this
# is the only AI credential needed - no Anthropic or OpenAI key of our own.
# On Vercel, VERCEL_OIDC_TOKEN is used automatically and this can be omitted.
# Create one at https://vercel.com/foundative/~/ai-gateway/api-keys
AI_GATEWAY_API_KEY=replace_with_your_vercel_ai_gateway_key

# Script Studio reel intake reuses VIRAL_APP_API_KEY above: the /live/instagram
# lookup returns the MP4, author, caption and duration in one call (3 credits).
# No separate scraper vendor is needed.
