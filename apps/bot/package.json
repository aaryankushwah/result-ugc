{
  "name": "@result/discord-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Result's Discord worker for UGC creator operations.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "deploy:commands": "tsx scripts/deploy-commands.ts",
    "reconcile:once": "tsx scripts/reconcile-once.ts",
    "reconcile:discord-links": "tsx scripts/reconcile-discord-links.ts",
    "invite": "tsx scripts/print-invite.ts",
    "test": "vitest run tests"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@result/db": "workspace:*",
    "@result/domain": "workspace:*",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.45.2",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  }
}
