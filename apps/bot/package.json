{
  "name": "@result/discord-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Result's Discord worker for UGC creator operations.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "deploy:commands": "tsx scripts/deploy-commands.ts",
    "invite": "tsx scripts/print-invite.ts",
    "test": "vitest run tests"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
