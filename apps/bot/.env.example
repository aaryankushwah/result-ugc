DISCORD_TOKEN=replace_with_your_bot_token
DISCORD_CLIENT_ID=replace_with_your_application_id
# Optional: deploy slash commands instantly to one test server.
DISCORD_GUILD_ID=replace_with_your_test_server_id
# Dub API token for /issue-link.
DUB_API_KEY=replace_with_your_dub_api_key
# Optional default destination for /issue-link; command `url` can override it.
DUB_DEFAULT_URL=https://result.dev
# Optional default partner ID; /issue-link can override it per creator.
DUB_DEFAULT_PARTNER_ID=optional_dub_partner_id
# Launchpoint public API key (read-only private-preview API).
LAUNCHPOINT_API_KEY=replace_with_your_launchpoint_api_key
